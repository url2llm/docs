{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "url2llm",
  "colors": {
    "primary": "#50426C",
    "light": "#B69BD9",
    "dark": "#50426C"
  },
  "logo": {
    "light": "/images/wordmark-light.svg",
    "dark": "/images/wordmark-dark.svg"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "getting-started/introduction",
              "getting-started/quickstart",
              "getting-started/authentication",
              "account/api-keys",
              "guides/http-clients"
            ]
          },
          {
            "group": "API guides",
            "pages": [
              "features/scrape",
              "features/map",
              "features/search",
              "features/collections",
              "features/brand-api",
              "guides/quote"
            ]
          },
          {
            "group": "Outputs",
            "pages": [
              "features/formats",
              "features/markdown-html",
              "features/screenshots",
              "features/links-assets",
              "features/branding"
            ]
          },
          {
            "group": "Reliability",
            "pages": [
              "guides/browser-rendering",
              "guides/retries",
              "guides/errors"
            ]
          },
          {
            "group": "Credits and billing",
            "pages": [
              "account/billing",
              "account/usage"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi-public.json"
      }
    ]
  },
  "api": {
    "playground": {
      "display": "none"
    }
  },
  "redirects": [
    { "source": "/guides/current-scrape", "destination": "/features/scrape" },
    { "source": "/introduction", "destination": "/getting-started/introduction" },
    { "source": "/quickstart", "destination": "/getting-started/quickstart" },
    { "source": "/authentication", "destination": "/getting-started/authentication" },
    { "source": "/dashboard", "destination": "/account/usage" },
    { "source": "/scrape", "destination": "/features/scrape" },
    { "source": "/formats", "destination": "/features/formats" },
    { "source": "/map", "destination": "/features/map" },
    { "source": "/quote", "destination": "/guides/quote" },
    { "source": "/errors", "destination": "/guides/errors" },
    { "source": "/guides/scrape", "destination": "/features/scrape" },
    { "source": "/drafts/scrape", "destination": "/features/scrape" },
    { "source": "/account/dashboard", "destination": "/account/usage" },
    { "source": "/account/organizations", "destination": "/account/api-keys" },
    { "source": "/account/team-access", "destination": "/account/api-keys" },
    { "source": "/account/security", "destination": "/getting-started/authentication" }
  ],
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://url2llm.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://url2llm.com/dashboard"
    }
  }
}
